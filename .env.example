# Telegram Serverless uses BotFather -> Serverless -> CLI Access for deploy.
# Keep these values in your secret manager; never commit real tokens.
TELEGRAM_BOT_TOKEN=
TGCLOUD_TOKEN=
OPENAI_API_KEY=
STORAGE_PROVIDER=telegram-serverless-or-s3
STORAGE_UPLOAD_URL=
GOOGLE_DRIVE_FOLDER_ID=
ADMIN_TELEGRAM_IDS=123456789
TIMEZONE=Asia/Tehran
DEFAULT_CURRENCY=TOMAN
MAX_FILE_MB=20

